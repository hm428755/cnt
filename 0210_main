"""
CNT 크로마토그래피 통합 실험 시스템 (OOP)

구조:
- DeviceManager: 모든 장비 통합 관리
- 함수화된 작업 단위
- 카메라 기반 흡수 자동 감지 (v10)

변경사항:
- 밸브: CNT = to_solution() (2번), 일루션 = to_air() (1번)
- CNT 주입 후 바로 일루션 (CNT 흡수 대기 없음)
- 흡수 완료 후 1분 대기 추가
"""

import time
from typing import Optional

from devices.pump import Pump
from devices.gilson import Gilson
from devices.jasco import Jasco
from devices.valve import Valve
from classifier import classify_csv
from config import *

# 카메라 흡수 감지
from pattern_refraction_v10 import (
    wait_for_absorbed,
    load_roi,
    load_baseline,
    init_camera,
    reset_buffers,
)


# ================================================================
#                    DeviceManager - 장비 통합 관리
# ================================================================

class DeviceManager:
    """모든 장비를 통합 관리하는 클래스"""

    def __init__(self):
        # 장비 객체
        self.pump_inj: Optional[Pump] = None
        self.pump_circ: Optional[Pump] = None
        self.valve: Optional[Valve] = None
        self.gilson: Optional[Gilson] = None
        self.jasco: Optional[Jasco] = None

        # 연결 상태
        self.valve_ok = False
        self.gilson_ok = False
        self.jasco_ok = False
        self.camera_ok = False

    def connect_all(self) -> dict:
        """모든 장비 연결"""
        status = {}

        # 주입 펌프
        self.pump_inj = Pump(
            **PUMP_INJECTION,
            baudrate=BAUDRATE,
            rev_per_ml=REV_PER_ML,
        )
        self.pump_inj.connect()
        status['pump_inj'] = True

        # 순환 펌프
        self.pump_circ = Pump(
            **PUMP_CIRCULATION,
            baudrate=BAUDRATE,
            rev_per_ml=REV_PER_ML,
        )
        self.pump_circ.connect()
        status['pump_circ'] = True

        # 밸브
        self.valve = Valve(port=VALVE_PORT, baudrate=VALVE_BAUDRATE)
        self.valve_ok = self.valve.connect()
        status['valve'] = self.valve_ok

        # Gilson
        self.gilson = Gilson(port=GILSON_PORT, unit_id=GILSON_UNIT_ID)
        self.gilson_ok = self.gilson.connect()
        status['gilson'] = self.gilson_ok

        # Jasco
        self.jasco = Jasco(
            window_title=JASCO_WINDOW_TITLE,
            watch_dir=JASCO_WATCH_DIR,
            output_dir=JASCO_OUTPUT_DIR,
            confidence=JASCO_CONFIDENCE,
            check_interval=JASCO_CHECK_INTERVAL,
            on_new_csv=self._on_uv_csv,
        )
        self.jasco_ok = self.jasco.connect()
        status['jasco'] = self.jasco_ok

        # 카메라 (패턴 감지)
        roi = load_roi()
        load_baseline()
        self.camera_ok = roi is not None
        status['camera'] = self.camera_ok

        return status

    def disconnect_all(self):
        """모든 장비 연결 해제"""
        if self.jasco_ok and self.jasco:
            self.jasco.disconnect()
        if self.valve_ok and self.valve:
            self.valve.disconnect()
        if self.pump_inj:
            self.pump_inj.disconnect()
        if self.pump_circ:
            self.pump_circ.disconnect()
        if self.gilson_ok and self.gilson:
            self.gilson.disconnect()

    def _on_uv_csv(self, csv_path):
        """UV CSV 콜백 → 분류 → Gilson 이동"""
        print(f"\n{'─'*40}")
        print(f"[자동분류] 새 스펙트럼: {csv_path.name}")

        result = classify_csv(csv_path)
        print(f"[자동분류] 결과: {result}")

        if UV_TO_GILSON_DELAY > 0:
            print(f"[자동분류] {UV_TO_GILSON_DELAY}초 대기...")
            time.sleep(UV_TO_GILSON_DELAY)

        if self.gilson_ok and self.gilson.connected:
            self.gilson.collect(
                result,
                tube_metal=TUBE_METAL,
                tube_semi=TUBE_SEMICONDUCTOR,
            )
        print(f"{'─'*40}")

    # ────────────────────────────────────
    # 펌프 조작
    # ────────────────────────────────────

    def inject_volume(self, volume_ml: float, flow_rate: float):
        """주입펌프로 볼륨 주입 (완료 후 자동 정지)"""
        self.pump_inj.run_volume(volume_ml, flow_rate)

    def start_circulation(self, flow_rate: float):
        """순환펌프 시작"""
        self.pump_circ.run_continuous(flow_rate)

    def stop_circulation(self):
        """순환펌프 정지"""
        self.pump_circ.stop()

    # ────────────────────────────────────
    # 밸브 조작 (수정됨)
    # ────────────────────────────────────

    def valve_to_elution(self):
        """밸브 → 일루션 (1번, 위)"""
        if self.valve_ok:
            self.valve.to_air()
        print("  [밸브] → 일루션 (1번)")

    def valve_to_cnt(self):
        """밸브 → CNT (2번, 아래)"""
        if self.valve_ok:
            self.valve.to_solution()
        print("  [밸브] → CNT (2번)")

    # ────────────────────────────────────
    # Gilson 조작
    # ────────────────────────────────────

    def gilson_to_waste(self):
        """Gilson → 폐기 위치"""
        if self.gilson_ok:
            self.gilson.go_waste()

    def gilson_collect(self, classification: str):
        """Gilson 수집"""
        if self.gilson_ok:
            self.gilson.collect(
                classification,
                tube_metal=TUBE_METAL,
                tube_semi=TUBE_SEMICONDUCTOR,
            )

    # ────────────────────────────────────
    # Jasco 조작
    # ────────────────────────────────────

    def jasco_start(self):
        """Jasco 모니터링 시작"""
        if self.jasco_ok:
            self.jasco.start_monitoring()

    def jasco_stop(self) -> int:
        """Jasco 모니터링 중단, 측정 횟수 반환"""
        if self.jasco_ok:
            self.jasco.stop_monitoring()
            return self.jasco.measurement_count
        return 0

    # ────────────────────────────────────
    # 카메라 흡수 감지
    # ────────────────────────────────────

    def wait_absorption(self, phase: str, timeout: int, delay_after: int = 0) -> bool:
        """
        카메라로 흡수 완료 대기
        
        Args:
            phase: 단계 이름 (로그용)
            timeout: 타임아웃 (초)
            delay_after: 흡수 완료 후 추가 대기 시간 (초)
        
        Returns:
            True = 흡수 감지됨
            False = 타임아웃 (카메라 미연결 포함)
        """
        if not self.camera_ok:
            print(f"  [카메라] 미연결 - {timeout}초 대기로 대체")
            time.sleep(timeout)
            return False
        
        print(f"  [카메라] {phase} 흡수 대기중... (최대 {timeout//60}분)")
        reset_buffers()
        
        success = wait_for_absorbed(timeout=timeout)
        
        if success:
            print(f"  [카메라] ✓ 흡수 완료!")
            
            # 흡수 완료 후 추가 대기
            if delay_after > 0:
                print(f"  [대기] {delay_after}초 추가 대기...")
                time.sleep(delay_after)
                print(f"  [대기] ✓ 대기 완료")
        else:
            print(f"  [카메라] ⚠ 타임아웃 - 감지 실패, 다음 단계로 진행")
        
        return success


# ================================================================
#                    작업 함수
# ================================================================

def run_conditioning(dm: DeviceManager):
    """컨디셔닝: 400ml"""
    print("\n" + "=" * 55)
    print("  Phase 1: 컨디셔닝")
    print(f"  {CONDITIONING_VOLUME}ml @ {CONDITIONING_FLOW_RATE} ml/min")
    est_min = CONDITIONING_VOLUME / CONDITIONING_FLOW_RATE
    print(f"  예상 소요: {est_min:.1f}분")
    print("=" * 55)

    dm.gilson_to_waste()
    dm.valve_to_elution()  # 컨디셔닝은 일루션 방향으로

    input("\n  ▶ 컨디셔닝 시작하려면 [Enter]...")

    dm.inject_volume(CONDITIONING_VOLUME, CONDITIONING_FLOW_RATE)

    print("\n  ✓ 컨디셔닝 주입 완료!")

    # 카메라로 흡수 감지 + 1분 대기
    dm.wait_absorption("컨디셔닝", TIMEOUT_CONDITIONING, delay_after=ABSORPTION_DELAY)


def run_cnt_sample(dm: DeviceManager, cycle: int, start_circulation: bool = False):
    """CNT 샘플: 10ml @ 3.3ml/min → 바로 일루션"""
    print(f"\n  ─────────────────────────────────")
    print(f"  [CNT 샘플] {SAMPLE_VOLUME}ml @ {SAMPLE_FLOW_RATE} ml/min")
    print(f"  ─────────────────────────────────")

    # 밸브 → CNT
    dm.valve_to_cnt()

    if start_circulation:
        print("  ※ 순환펌프 시작")
        dm.start_circulation(SLOW_FLOW_RATE)
        dm.jasco_start()
        print("  [Jasco] 자동 측정 시작")

    dm.inject_volume(SAMPLE_VOLUME, SAMPLE_FLOW_RATE)

    print("\n  ✓ CNT 주입 완료!")
    
    # CNT 흡수 대기 없음 → 바로 일루션으로


def run_elution(dm: DeviceManager, cycle: int):
    """일루션: 50ml @ 20ml/min"""
    print(f"\n  ─────────────────────────────────")
    print(f"  [일루션] {ELUTION_VOLUME}ml @ {ELUTION_FLOW_RATE} ml/min")
    print(f"  ─────────────────────────────────")

    # 밸브 → 일루션
    dm.valve_to_elution()

    dm.inject_volume(ELUTION_VOLUME, ELUTION_FLOW_RATE)

    print("\n  ✓ 일루션 주입 완료!")

    # 카메라로 흡수 감지 + 1분 대기
    dm.wait_absorption("일루션", TIMEOUT_ELUTION, delay_after=ABSORPTION_DELAY)


def run_gilson_manual_test(dm: DeviceManager):
    """Gilson 수동 분류 테스트"""
    if not dm.gilson_ok:
        print("  [Gilson] 미연결 - 건너뜀")
        return

    print("\n  ┌─────────────────────────────────┐")
    print("  │  Gilson 분류 이동 테스트         │")
    print("  │  1 = 금속    (튜브 %3d)         │" % TUBE_METAL)
    print("  │  2 = 반도체  (튜브 %3d)         │" % TUBE_SEMICONDUCTOR)
    print("  │  3 = 폐기    (drain)            │")
    print("  │  s = 건너뛰기                    │")
    print("  └─────────────────────────────────┘")

    while True:
        choice = input("  분류 결과 (1/2/3/s): ").strip()
        if choice == "1":
            dm.gilson_collect("금속")
            break
        elif choice == "2":
            dm.gilson_collect("반도체")
            break
        elif choice == "3":
            dm.gilson_collect("폐기")
            break
        elif choice.lower() == "s":
            print("  [Gilson] 건너뜀")
            break
        else:
            print("  → 1, 2, 3, s 중 하나를 입력하세요")


# ================================================================
#                    메인
# ================================================================

def main():
    mode_str = "⚡ 테스트 모드" if TEST_MODE else "🔬 실제 실험"

    print("\n" + "=" * 55)
    print("   CNT 크로마토그래피 통합 제어 시스템")
    print(f"   [{mode_str}]")
    print("=" * 55)

    # ──────────────────────────────────────
    # 장비 연결
    # ──────────────────────────────────────

    dm = DeviceManager()
    status = dm.connect_all()

    print(f"\n[장비 연결]")
    print(f"  펌프(주입): ✓")
    print(f"  펌프(순환): ✓")
    print(f"  밸브: {'✓' if status['valve'] else '✗'}")
    print(f"  Gilson: {'✓' if status['gilson'] else '✗'}")
    print(f"  Jasco: {'✓' if status['jasco'] else '✗'}")
    print(f"  카메라: {'✓' if status['camera'] else '✗ (ROI 미설정)'}")

    print("─" * 55)
    print(f"  컨디셔닝: {CONDITIONING_VOLUME}ml @ {CONDITIONING_FLOW_RATE} ml/min")
    print(f"  CNT 샘플: {SAMPLE_VOLUME}ml @ {SAMPLE_FLOW_RATE} ml/min")
    print(f"  일루션: {ELUTION_VOLUME}ml @ {ELUTION_FLOW_RATE} ml/min")
    print(f"  흡수 후 대기: {ABSORPTION_DELAY}초")
    print(f"  반복: {NUM_CYCLES}회")
    print("─" * 55)
    print("  Ctrl+C = 긴급 정지")
    print("=" * 55)

    try:
        # ──────────────────────────────────────
        # Phase 1: 컨디셔닝
        # ──────────────────────────────────────

        run_conditioning(dm)

        # ──────────────────────────────────────
        # Phase 2+: 사이클 반복
        # ──────────────────────────────────────

        for cycle in range(1, NUM_CYCLES + 1):
            print("\n" + "★" * 55)
            print(f"  사이클 {cycle}/{NUM_CYCLES}")
            print("★" * 55)

            # CNT 샘플 (첫 사이클에서 순환펌프 시작)
            run_cnt_sample(dm, cycle, start_circulation=(cycle == 1))

            # 일루션 (CNT 바로 다음, 흡수 대기 없음)
            run_elution(dm, cycle)

            # Gilson 수동 테스트
            run_gilson_manual_test(dm)

            print(f"\n  ✓ 사이클 {cycle} 완료")

        # ──────────────────────────────────────
        # 종료
        # ──────────────────────────────────────

        print("\n" + "=" * 55)
        print("  실험 종료")
        print("=" * 55)

        measurement_count = dm.jasco_stop()
        dm.valve_to_elution()

        input("\n--- 순환펌프 정지하려면 [Enter] ---")
        dm.stop_circulation()

        print("\n" + "=" * 55)
        print(f"  실험 완료! ({NUM_CYCLES}사이클)")
        print(f"  총 UV 측정: {measurement_count}회")
        print("=" * 55)

    except KeyboardInterrupt:
        print("\n\n긴급 중단!")

    finally:
        dm.disconnect_all()
        print("\n시스템 종료")


if __name__ == "__main__":
    main()
