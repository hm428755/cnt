# ============================================================
#  메인
# ============================================================

def main():
    load_baseline()
    
    while True:
        print("\n" + "=" * 50)
        print("  투명 용액 감지 v10")
        print("=" * 50)
        
        roi = load_roi()
        print(f"  ROI: {roi if roi else '없음'}")
        print(f"  기준 각도: {BASELINE_ANGLE:.1f}°")
        
        print("""
  1. ROI 설정
  2. 실시간 영상
  3. 캘리브레이션
  4. 모니터링
  q. 종료
""")
        
        choice = input("선택 >> ").strip().lower()
        
        if choice == '1':
            select_roi()
        elif choice == '2':
            live_view()
        elif choice == '3':
            calibrate()
        elif choice == '4':
            monitor()
        elif choice == 'q':
            print("종료")
            break


if __name__ == "__main__":
    main()
