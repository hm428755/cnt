"""
패턴 굴절 감지 v10 - 투명 용액 감지 (패턴 하단 도달)

투명 용액: 패턴이 ROI 하단까지 닿으면 → 흡수 완료
"""

import cv2
import numpy as np
import time
import json
import os
import winsound
from collections import deque
from PIL import ImageFont, ImageDraw, Image


# ============================================================
#                    [설정]
# ============================================================

CAMERA_INDEX = 1

ANTI_FLICKER = True
FRAME_AVG_COUNT = 5

BLUR_KERNEL = 3
ROI_MARGIN = 5

CANNY_LOW = 50
CANNY_HIGH = 150
HOUGH_THRESHOLD = 25
MIN_LINE_LENGTH = 20
MAX_LINE_GAP = 10

BASELINE_ANGLE = 54.2
PATTERN_ANGLE_TOLERANCE = 20.0
BOTTOM_MARGIN_PX = 3

MOVING_AVG_SIZE = 5

ROI_FILE = 'roi_settings.json'
BASELINE_FILE = 'baseline_settings.json'

CHECK_INTERVAL = 0.5
STABLE_COUNT = 8


# ============================================================
#  기준 각도 저장/로드
# ============================================================

def save_baseline(angle):
    with open(BASELINE_FILE, 'w') as f:
        json.dump({'baseline_angle': angle}, f)
    print(f"기준 각도 저장: {angle:.1f}°")

def load_baseline():
    global BASELINE_ANGLE
    if os.path.exists(BASELINE_FILE):
        with open(BASELINE_FILE, 'r') as f:
            data = json.load(f)
            BASELINE_ANGLE = data.get('baseline_angle', 54.2)
            print(f"기준 각도 로드: {BASELINE_ANGLE:.1f}°")
    return BASELINE_ANGLE


# ============================================================
#  이동평균
# ============================================================
max_y_buffer = deque(maxlen=MOVING_AVG_SIZE)

def get_smoothed_max_y(max_y):
    max_y_buffer.append(max_y)
    return float(np.mean(max_y_buffer)) if max_y_buffer else max_y

def reset_buffers():
    max_y_buffer.clear()


# ============================================================
#  한글 폰트
# ============================================================

def get_korean_font(size=20):
    font_paths = [
        "C:/Windows/Fonts/malgun.ttf",
        "C:/Windows/Fonts/gulim.ttc",
        "C:/Windows/Fonts/batang.ttc",
        "C:/Windows/Fonts/NanumGothic.ttf",
    ]
    for fp in font_paths:
        if os.path.exists(fp):
            return ImageFont.truetype(fp, size)
    return ImageFont.load_default()

FONT_LARGE = get_korean_font(24)
FONT_MEDIUM = get_korean_font(18)
FONT_SMALL = get_korean_font(14)

def put_korean_text(img, text, pos, font=None, color=(255, 255, 255)):
    if font is None:
        font = FONT_MEDIUM
    img_pil = Image.fromarray(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
    draw = ImageDraw.Draw(img_pil)
    rgb_color = (color[2], color[1], color[0])
    draw.text(pos, text, font=font, fill=rgb_color)
    result = cv2.cvtColor(np.array(img_pil), cv2.COLOR_RGB2BGR)
    np.copyto(img, result)


# ============================================================
#  ROI
# ============================================================

drawing = False
start_point = None
end_point = None
roi_rect = None

def mouse_callback(event, x, y, flags, param):
    global drawing, start_point, end_point, roi_rect
    if event == cv2.EVENT_LBUTTONDOWN:
        drawing = True
        start_point = (x, y)
    elif event == cv2.EVENT_MOUSEMOVE and drawing:
        end_point = (x, y)
    elif event == cv2.EVENT_LBUTTONUP:
        drawing = False
        end_point = (x, y)
        x1, y1 = min(start_point[0], end_point[0]), min(start_point[1], end_point[1])
        x2, y2 = max(start_point[0], end_point[0]), max(start_point[1], end_point[1])
        roi_rect = (x1, y1, x2, y2)

def save_roi(roi):
    with open(ROI_FILE, 'w') as f:
        json.dump({'roi': roi}, f)

def load_roi():
    if os.path.exists(ROI_FILE):
        with open(ROI_FILE, 'r') as f:
            return tuple(json.load(f)['roi'])
    return None


# ============================================================
#  카메라
# ============================================================

def init_camera():
    cap = cv2.VideoCapture(CAMERA_INDEX)
    if not cap.isOpened():
        print("카메라 연결 실패!")
        return None
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 1920)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 1080)
    w = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
    h = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
    print(f"카메라 연결됨 ({w}x{h})")
    return cap

def read_frame(cap):
    if not ANTI_FLICKER:
        ret, frame = cap.read()
        return ret, frame
    frames = []
    for _ in range(FRAME_AVG_COUNT):
        ret, frame = cap.read()
        if ret:
            frames.append(frame.astype(np.float32))
    if not frames:
        return False, None
    return True, np.mean(frames, axis=0).astype(np.uint8)


# ============================================================
#  직선 분석
# ============================================================

def get_line_angle(line):
    x1, y1, x2, y2 = line[0]
    dx = x2 - x1
    dy = y2 - y1
    angle = np.degrees(np.arctan2(dy, dx))
    if angle > 90:
        angle -= 180
    elif angle < -90:
        angle += 180
    return angle

def get_line_max_y(line):
    x1, y1, x2, y2 = line[0]
    return max(y1, y2)

def classify_lines_v10(lines, roi_height):
    if lines is None or len(lines) == 0:
        return None, None, 0
    
    pattern_lines = []
    other_lines = []
    pattern_max_y = 0
    
    for line in lines:
        angle = get_line_angle(line)
        deviation = abs(angle - BASELINE_ANGLE)
        max_y = get_line_max_y(line)
        
        if deviation <= PATTERN_ANGLE_TOLERANCE:
            pattern_lines.append(line)
            if max_y > pattern_max_y:
                pattern_max_y = max_y
        else:
            other_lines.append(line)
    
    pattern_arr = np.array(pattern_lines) if pattern_lines else None
    other_arr = np.array(other_lines) if other_lines else None
    
    return pattern_arr, other_arr, pattern_max_y


# ============================================================
#  핵심 분석
# ============================================================

def analyze_pattern(gray):
    h, w = gray.shape
    
    if ROI_MARGIN > 0 and h > ROI_MARGIN * 2 and w > ROI_MARGIN * 2:
        gray = gray[ROI_MARGIN:h-ROI_MARGIN, ROI_MARGIN:w-ROI_MARGIN]
        h, w = gray.shape
    
    roi_height = h
    
    if BLUR_KERNEL > 0:
        gray_proc = cv2.GaussianBlur(gray, (BLUR_KERNEL, BLUR_KERNEL), 0)
    else:
        gray_proc = gray
    
    edges = cv2.Canny(gray_proc, CANNY_LOW, CANNY_HIGH)
    lines_raw = cv2.HoughLinesP(edges, 1, np.pi / 180,
                                threshold=HOUGH_THRESHOLD,
                                minLineLength=MIN_LINE_LENGTH,
                                maxLineGap=MAX_LINE_GAP)
    
    if lines_raw is None or len(lines_raw) == 0:
        return {
            'absorbed': False,
            'pattern_count': 0,
            'pattern_max_y': 0,
            'smoothed_max_y': get_smoothed_max_y(0),
            'roi_height': roi_height,
            'distance_to_bottom': roi_height,
            'reach_ratio': 0.0,
            'pattern_lines': None,
            'other_lines': None,
            'angle_mean': 0.0,
        }
    
    pattern_lines, other_lines, pattern_max_y = classify_lines_v10(lines_raw, roi_height)
    
    if pattern_lines is not None and len(pattern_lines) > 0:
        angles = [get_line_angle(line) for line in pattern_lines]
        angle_mean = float(np.mean(angles))
        pattern_count = len(pattern_lines)
    else:
        angle_mean = 0.0
        pattern_count = 0
        pattern_max_y = 0
    
    smoothed_max_y = get_smoothed_max_y(pattern_max_y)
    distance_to_bottom = roi_height - smoothed_max_y
    reach_ratio = smoothed_max_y / roi_height if roi_height > 0 else 0
    absorbed = distance_to_bottom <= BOTTOM_MARGIN_PX
    
    return {
        'absorbed': absorbed,
        'pattern_count': pattern_count,
        'pattern_max_y': pattern_max_y,
        'smoothed_max_y': smoothed_max_y,
        'roi_height': roi_height,
        'distance_to_bottom': distance_to_bottom,
        'reach_ratio': reach_ratio,
        'pattern_lines': pattern_lines,
        'other_lines': other_lines,
        'angle_mean': angle_mean,
    }

def beep_alert():
    try:
        winsound.Beep(1000, 500)
    except:
        print("\a")


# ============================================================
#  상태 판별
# ============================================================

def classify_state(metrics):
    if metrics['absorbed']:
        return "흡수 완료", (0, 255, 0), 'absorbed'
    else:
        return "용액 있음", (0, 255, 255), 'liquid'


# ============================================================
#  그리기
# ============================================================

def draw_lines_v10(display, metrics, roi):
    x1_roi, y1_roi, x2_roi, y2_roi = roi
    offset_x = x1_roi + ROI_MARGIN
    offset_y = y1_roi + ROI_MARGIN
    
    if metrics['pattern_lines'] is not None:
        for line in metrics['pattern_lines']:
            lx1, ly1, lx2, ly2 = line[0]
            cv2.line(display, 
                     (offset_x + lx1, offset_y + ly1), 
                     (offset_x + lx2, offset_y + ly2), 
                     (0, 255, 0), 2)
    
    if metrics['other_lines'] is not None:
        for line in metrics['other_lines']:
            lx1, ly1, lx2, ly2 = line[0]
            cv2.line(display, 
                     (offset_x + lx1, offset_y + ly1), 
                     (offset_x + lx2, offset_y + ly2), 
                     (128, 128, 128), 1)

def draw_reach_bar(display, reach_ratio, absorbed, x, y, width=150, height=20):
    cv2.rectangle(display, (x, y), (x + width, y + height), (50, 50, 50), -1)
    
    if absorbed:
        color = (0, 255, 0)
    elif reach_ratio >= 0.7:
        color = (0, 255, 255)
    else:
        color = (0, 165, 255)
    
    fill_width = int(width * min(reach_ratio, 1.0))
    if fill_width > 0:
        cv2.rectangle(display, (x, y), (x + fill_width, y + height), color, -1)
    
    cv2.rectangle(display, (x, y), (x + width, y + height), (200, 200, 200), 1)

def draw_info_panel(display, metrics, status, color):
    put_korean_text(display, status, (10, 10), FONT_LARGE, color)
    put_korean_text(display, f"도달: {metrics['reach_ratio']*100:.0f}%", (10, 50), FONT_MEDIUM, color)
    draw_reach_bar(display, metrics['reach_ratio'], metrics['absorbed'], 10, 80, 150, 15)
    put_korean_text(display, f"패턴: {metrics['pattern_count']}개 | 기준각도: {BASELINE_ANGLE:.0f}°",
                    (10, 105), FONT_SMALL, (150, 150, 150))


# ============================================================
#  자동화용 함수
# ============================================================

def wait_for_absorbed(timeout=300):
    """투명 용액 흡수 완료 대기 (패턴 도달)"""
    roi = load_roi()
    if not roi:
        print("ROI 없음!")
        return False
    cap = init_camera()
    if not cap:
        return False
    
    load_baseline()
    x1, y1, x2, y2 = roi
    stable_counter = 0
    start_time = time.time()
    reset_buffers()
    print("흡수 대기...")
    
    while time.time() - start_time < timeout:
        ret, frame = read_frame(cap)
        if not ret:
            continue
        roi_frame = frame[y1:y2, x1:x2]
        gray = cv2.cvtColor(roi_frame, cv2.COLOR_BGR2GRAY)
        m = analyze_pattern(gray)
        
        if m['absorbed']:
            stable_counter += 1
        else:
            stable_counter = 0
        
        elapsed = time.time() - start_time
        status = "흡수완료" if m['absorbed'] else "흡수중"
        print(f"\r   {elapsed:.0f}초 | {status} | 도달:{m['reach_ratio']*100:.0f}% | {stable_counter}/{STABLE_COUNT}",
              end='', flush=True)
        
        if stable_counter >= STABLE_COUNT:
            beep_alert()
            print(f"\n완료!")
            cap.release()
            return True
        time.sleep(CHECK_INTERVAL)
    
    print(f"\n타임아웃")
    cap.release()
    return False


def wait_for_absorbed_with_display(cap, roi, timeout=300, phase_name="흡수 대기"):
    """카메라 화면 표시하면서 흡수 대기"""
    x1, y1, x2, y2 = roi
    stable_counter = 0
    start_time = time.time()
    reset_buffers()
    
    while time.time() - start_time < timeout:
        ret, frame = read_frame(cap)
        if not ret:
            continue
        
        roi_frame = frame[y1:y2, x1:x2]
        gray = cv2.cvtColor(roi_frame, cv2.COLOR_BGR2GRAY)
        m = analyze_pattern(gray)
        
        if m['absorbed']:
            stable_counter += 1
        else:
            stable_counter = 0
        
        # 화면 표시
        display = frame.copy()
        
        if m['absorbed']:
            box_color = (0, 255, 0)
            status = f"흡수 완료! ({stable_counter}/{STABLE_COUNT})"
        else:
            box_color = (0, 255, 255)
            status = "흡수중..."
        
        cv2.rectangle(display, (x1, y1), (x2, y2), box_color, 2)
        draw_lines_v10(display, m, roi)
        
        elapsed = time.time() - start_time
        
        put_korean_text(display, phase_name, (10, 10), FONT_LARGE, (255, 255, 255))
        put_korean_text(display, f"{status}", (10, 50), FONT_MEDIUM, box_color)
        put_korean_text(display, f"도달: {m['reach_ratio']*100:.0f}% | 경과: {elapsed:.0f}초", (10, 85), FONT_MEDIUM, (255, 255, 0))
        put_korean_text(display, "Q=종료 S=건너뛰기", (10, 120), FONT_SMALL, (200, 200, 200))
        
        draw_reach_bar(display, m['reach_ratio'], m['absorbed'], 10, 150, 200, 20)
        
        cv2.imshow("CNT Automation", display)
        
        key = cv2.waitKey(1) & 0xFF
        if key == ord('q'):
            return 'quit'
        elif key == ord('s'):
            return 'skip'
        
        if stable_counter >= STABLE_COUNT:
            beep_alert()
            return 'done'
    
    return 'timeout'


def wait_for_liquid(timeout=60):
    """용액이 들어올 때까지 대기"""
    roi = load_roi()
    if not roi:
        return False
    cap = init_camera()
    if not cap:
        return False
    
    load_baseline()
    x1, y1, x2, y2 = roi
    stable_counter = 0
    start_time = time.time()
    reset_buffers()
    print("용액 대기...")
    
    while time.time() - start_time < timeout:
        ret, frame = read_frame(cap)
        if not ret:
            continue
        roi_frame = frame[y1:y2, x1:x2]
        gray = cv2.cvtColor(roi_frame, cv2.COLOR_BGR2GRAY)
        m = analyze_pattern(gray)
        
        if not m['absorbed']:
            stable_counter += 1
        else:
            stable_counter = 0
        
        elapsed = time.time() - start_time
        status = "용액" if not m['absorbed'] else "빈"
        print(f"\r   {elapsed:.0f}초 | {status} | 도달:{m['reach_ratio']*100:.0f}% | {stable_counter}/{STABLE_COUNT}",
              end='', flush=True)
        
        if stable_counter >= STABLE_COUNT:
            print(f"\n감지!")
            cap.release()
            return True
        time.sleep(CHECK_INTERVAL)
    
    print(f"\n타임아웃")
    cap.release()
    return False


# ============================================================
#  메뉴들
# ============================================================

def select_roi():
    global roi_rect
    print("\nROI 설정 | Enter=확정 | R=리셋 | Q=취소")
    
    cap = init_camera()
    if not cap:
        return
    
    cv2.namedWindow("Select ROI")
    cv2.setMouseCallback("Select ROI", mouse_callback)
    roi_rect = None
    reset_buffers()
    load_baseline()
    
    while True:
        ret, frame = read_frame(cap)
        if not ret:
            break
        
        display = frame.copy()
        
        if drawing and start_point and end_point:
            cv2.rectangle(display, start_point, end_point, (0, 255, 0), 2)
        
        if roi_rect:
            x1, y1, x2, y2 = roi_rect
            roi_frame = frame[y1:y2, x1:x2]
            gray = cv2.cvtColor(roi_frame, cv2.COLOR_BGR2GRAY)
            m = analyze_pattern(gray)
            
            cv2.rectangle(display, (x1, y1), (x2, y2), (0, 255, 0), 2)
            draw_lines_v10(display, m, roi_rect)
            
            status = "흡수완료" if m['absorbed'] else "용액있음"
            color = (0, 255, 0) if m['absorbed'] else (0, 255, 255)
            put_korean_text(display, f"{status} | 도달:{m['reach_ratio']*100:.0f}%", 
                           (x1, y1 - 25), FONT_SMALL, color)
        
        cv2.imshow("Select ROI", display)
        
        key = cv2.waitKey(1) & 0xFF
        if key == 13 and roi_rect:
            save_roi(roi_rect)
            print(f"ROI 저장됨: {roi_rect}")
            break
        elif key == ord('r'):
            roi_rect = None
            reset_buffers()
        elif key == ord('q'):
            break
    
    cap.release()
    cv2.destroyAllWindows()

def live_view():
    print("\n실시간 영상 | Q=종료")
    
    cap = init_camera()
    if not cap:
        return
    
    roi = load_roi()
    load_baseline()
    reset_buffers()
    
    while True:
        ret, frame = read_frame(cap)
        if not ret:
            break
        
        display = frame.copy()
        
        if roi:
            x1, y1, x2, y2 = roi
            roi_frame = frame[y1:y2, x1:x2]
            gray = cv2.cvtColor(roi_frame, cv2.COLOR_BGR2GRAY)
            
            m = analyze_pattern(gray)
            status, color, _ = classify_state(m)
            
            cv2.rectangle(display, (x1, y1), (x2, y2), color, 2)
            draw_lines_v10(display, m, roi)
            draw_info_panel(display, m, status, color)
        
        cv2.imshow("Live View", display)
        
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break
    
    cap.release()
    cv2.destroyAllWindows()

def calibrate():
    global BASELINE_ANGLE
    
    print("\n캘리브레이션 | [B]기준각도 설정 | [Q]종료")
    
    roi = load_roi()
    if not roi:
        print("ROI 없음!")
        return
    
    cap = init_camera()
    if not cap:
        return
    
    load_baseline()
    x1, y1, x2, y2 = roi
    reset_buffers()
    
    while True:
        ret, frame = read_frame(cap)
        if not ret:
            break
        
        roi_frame = frame[y1:y2, x1:x2]
        gray = cv2.cvtColor(roi_frame, cv2.COLOR_BGR2GRAY)
        m = analyze_pattern(gray)
        status, color, _ = classify_state(m)
        
        display = frame.copy()
        cv2.rectangle(display, (x1, y1), (x2, y2), color, 2)
        draw_lines_v10(display, m, roi)
        
        put_korean_text(display, f"{status}", (10, 10), FONT_LARGE, color)
        put_korean_text(display, f"도달:{m['reach_ratio']*100:.0f}% | 기준:{BASELINE_ANGLE:.1f}°",
                        (10, 50), FONT_MEDIUM, (255, 255, 0))
        
        cv2.imshow("Calibration", display)
        
        key = cv2.waitKey(1) & 0xFF
        
        if key == ord('b') or key == ord('B'):
            if m['pattern_count'] >= 2:
                BASELINE_ANGLE = m['angle_mean']
                save_baseline(BASELINE_ANGLE)
                reset_buffers()
                print(f"\n★ 기준 각도: {BASELINE_ANGLE:.1f}°")
        
        elif key == ord('q') or key == ord('Q'):
            break
    
    cap.release()
    cv2.destroyAllWindows()

