def get_korean_font(size=20):
    font_paths = [
        "C:/Windows/Fonts/malgun.ttf",
        "C:/Windows/Fonts/gulim.ttc",
        "C:/Windows/Fonts/batang.ttc",
        "C:/Windows/Fonts/NanumGothic.ttf",
    ]
    for fp in font_paths:
        if os.path.exists(fp):
            return ImageFont.truetype(fp, size)
    return ImageFont.load_default()


FONT_LARGE = get_korean_font(24)
FONT_MEDIUM = get_korean_font(18)
FONT_SMALL = get_korean_font(14)


def put_korean_text(img, text, pos, font=None, color=(255, 255, 255)):
    if font is None:
        font = FONT_MEDIUM
    img_pil = Image.fromarray(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
    draw = ImageDraw.Draw(img_pil)
    rgb_color = (color[2], color[1], color[0])
    draw.text(pos, text, font=font, fill=rgb_color)
    result = cv2.cvtColor(np.array(img_pil), cv2.COLOR_RGB2BGR)
    np.copyto(img, result)


# ============================================================
#  ROI
# ============================================================

drawing = False
start_point = None
end_point = None
roi_rect = None


def mouse_callback(event, x, y, flags, param):
    global drawing, start_point, end_point, roi_rect
    if event == cv2.EVENT_LBUTTONDOWN:
        drawing = True
        start_point = (x, y)
    elif event == cv2.EVENT_MOUSEMOVE and drawing:
        end_point = (x, y)
    elif event == cv2.EVENT_LBUTTONUP:
        drawing = False
        end_point = (x, y)
        x1, y1 = min(start_point[0], end_point[0]), min(start_point[1], end_point[1])
        x2, y2 = max(start_point[0], end_point[0]), max(start_point[1], end_point[1])
        roi_rect = (x1, y1, x2, y2)


def save_roi(roi):
    with open(ROI_FILE, 'w') as f:
        json.dump({'roi': roi}, f)


def load_roi():
    if os.path.exists(ROI_FILE):
        with open(ROI_FILE, 'r') as f:
            return tuple(json.load(f)['roi'])
    return None


# ============================================================
#  카메라
# ============================================================

def init_camera():
    cap = cv2.VideoCapture(CAMERA_INDEX)
    if not cap.isOpened():
        print("카메라 연결 실패!")
        return None
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 1920)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 1080)
    w = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
    h = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
    print(f"카메라 연결됨 ({w}x{h})")
    return cap


def read_frame(cap):
    if not ANTI_FLICKER:
        ret, frame = cap.read()
        return ret, frame
    frames = []
    for _ in range(FRAME_AVG_COUNT):
        ret, frame = cap.read()
        if ret:
            frames.append(frame.astype(np.float32))
    if not frames:
        return False, None
    return True, np.mean(frames, axis=0).astype(np.uint8)


# ============================================================
#  직선 분석
# ============================================================

def get_line_length(line):
    x1, y1, x2, y2 = line[0]
    return np.sqrt((x2 - x1)**2 + (y2 - y1)**2)


def get_line_angle(line):
    x1, y1, x2, y2 = line[0]
    dx = x2 - x1
    dy = y2 - y1
    angle = np.degrees(np.arctan2(dy, dx))
    if angle > 90:
        angle -= 180
    elif angle < -90:
        angle += 180
    return angle


def get_line_max_y(line):
    """직선의 최대 y좌표 (하단)"""
    x1, y1, x2, y2 = line[0]
    return max(y1, y2)


def get_line_min_y(line):
    """직선의 최소 y좌표 (상단)"""
    x1, y1, x2, y2 = line[0]
    return min(y1, y2)


def classify_lines_v10(lines, roi_height):
    """
    직선을 패턴 vs 기타로 분류하고, 패턴의 최대 y좌표 추적
    
    반환:
        pattern_lines: 패턴 직선들
        other_lines: 기타 직선들
        pattern_max_y: 패턴 직선들의 최대 y좌표 (가장 아래까지 내려간 위치)
    """
    if lines is None or len(lines) == 0:
        return None, None, 0
    
    pattern_lines = []
    other_lines = []
    pattern_max_y = 0
    
    for line in lines:
        angle = get_line_angle(line)
        deviation = abs(angle - BASELINE_ANGLE)
        max_y = get_line_max_y(line)
        
        # 패턴 직선인지
        if deviation <= PATTERN_ANGLE_TOLERANCE:
            pattern_lines.append(line)
            
            # 패턴 최대 y 업데이트
            if max_y > pattern_max_y:
                pattern_max_y = max_y
        else:
            other_lines.append(line)
    
    pattern_arr = np.array(pattern_lines) if pattern_lines else None
    other_arr = np.array(other_lines) if other_lines else None
    
    return pattern_arr, other_arr, pattern_max_y


# ============================================================
#  핵심 분석 함수 (v10)
# ============================================================

def analyze_pattern(gray):
    """
    v10: 패턴이 ROI 바닥까지 도달했는지 검출
    
    패턴이 ROI 바닥(- margin)까지 닿으면 → 흡수 완료
    패턴이 위에만 있으면 → 용액 있음
    """
    h, w = gray.shape
    
    # 마진 적용
    if ROI_MARGIN > 0 and h > ROI_MARGIN * 2 and w > ROI_MARGIN * 2:
        gray = gray[ROI_MARGIN:h-ROI_MARGIN, ROI_MARGIN:w-ROI_MARGIN]
        h, w = gray.shape
    
    roi_height = h
    
    # 블러
    if BLUR_KERNEL > 0:
        gray_proc = cv2.GaussianBlur(gray, (BLUR_KERNEL, BLUR_KERNEL), 0)
    else:
        gray_proc = gray
    
    # 엣지 & 직선
    edges = cv2.Canny(gray_proc, CANNY_LOW, CANNY_HIGH)
    lines_raw = cv2.HoughLinesP(edges, 1, np.pi / 180,
                                threshold=HOUGH_THRESHOLD,
                                minLineLength=MIN_LINE_LENGTH,
                                maxLineGap=MAX_LINE_GAP)
    
    if lines_raw is None or len(lines_raw) == 0:
        return {
            'absorbed': False,
            'pattern_count': 0,
            'pattern_max_y': 0,
            'smoothed_max_y': get_smoothed_max_y(0),
            'roi_height': roi_height,
            'distance_to_bottom': roi_height,
            'reach_ratio': 0.0,
            'pattern_lines': None,
            'other_lines': None,
            'angle_mean': 0.0
        }
    
    # 직선 분류
    pattern_lines, other_lines, pattern_max_y = classify_lines_v10(lines_raw, roi_height)
    
    # 패턴 각도 평균
    if pattern_lines is not None and len(pattern_lines) > 0:
        angles = [get_line_angle(line) for line in pattern_lines]
        angle_mean = float(np.mean(angles))
        pattern_count = len(pattern_lines)
    else:
        angle_mean = 0.0
        pattern_count = 0
        pattern_max_y = 0
    
    # 이동평균
    smoothed_max_y = get_smoothed_max_y(pattern_max_y)
    
    # 바닥까지 거리
    distance_to_bottom = roi_height - smoothed_max_y
    
    # 도달 비율 (패턴이 ROI의 몇 %까지 내려왔는지)
    reach_ratio = smoothed_max_y / roi_height if roi_height > 0 else 0
    
    # 흡수 완료 판별: 패턴이 바닥에서 BOTTOM_MARGIN_PX 이내까지 도달
    absorbed = distance_to_bottom <= BOTTOM_MARGIN_PX
    
    return {
        'absorbed': absorbed,
        'pattern_count': pattern_count,
        'pattern_max_y': pattern_max_y,
        'smoothed_max_y': smoothed_max_y,
        'roi_height': roi_height,
        'distance_to_bottom': distance_to_bottom,
        'reach_ratio': reach_ratio,
        'pattern_lines': pattern_lines,
        'other_lines': other_lines,
        'angle_mean': angle_mean
    }


