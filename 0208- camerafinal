def select_roi():
    global roi_rect
    print("\n" + "=" * 50)
    print("  ROI 설정 (v10)")
    print("  ★ ROI를 젤 표면 위쪽에 설정하세요")
    print("  Enter=확정 | R=리셋 | Q=취소")
    print("=" * 50)
    
    cap = init_camera()
    if not cap:
        return
    
    cv2.namedWindow("Select ROI")
    cv2.setMouseCallback("Select ROI", mouse_callback)
    roi_rect = None
    reset_buffers()
    load_baseline()
    
    while True:
        ret, frame = read_frame(cap)
        if not ret:
            break
        
        display = frame.copy()
        
        if drawing and start_point and end_point:
            cv2.rectangle(display, start_point, end_point, (0, 255, 0), 2)
        
        if roi_rect:
            x1, y1, x2, y2 = roi_rect
            
            roi_frame = frame[y1:y2, x1:x2]
            gray = cv2.cvtColor(roi_frame, cv2.COLOR_BGR2GRAY)
            m = analyze_pattern(gray)
            
            cv2.rectangle(display, (x1, y1), (x2, y2), (0, 255, 0), 2)
            draw_lines_v10(display, m, roi_rect)
            
            status = "흡수완료" if m['absorbed'] else "용액있음"
            color = (0, 255, 0) if m['absorbed'] else (0, 255, 255)
            put_korean_text(display, f"{status} | 도달:{m['reach_ratio']*100:.0f}% 거리:{m['distance_to_bottom']:.0f}px", 
                           (x1, y1 - 25), FONT_SMALL, color)
        
        cv2.imshow("Select ROI", display)
        
        key = cv2.waitKey(1) & 0xFF
        if key == 13 and roi_rect:
            save_roi(roi_rect)
            print(f"ROI 저장됨: {roi_rect}")
            break
        elif key == ord('r'):
            roi_rect = None
            reset_buffers()
        elif key == ord('q'):
            break
    
    cap.release()
    cv2.destroyAllWindows()


def live_view():
    print("\n" + "=" * 50)
    print("  실시간 영상 (v10)")
    print("  초록선 = 패턴")
    print("  초록선이 ROI 바닥까지 닿으면 = 흡수 완료")
    print("  Q=종료")
    print("=" * 50)
    
    cap = init_camera()
    if not cap:
        return
    
    roi = load_roi()
    load_baseline()
    reset_buffers()
    
    while True:
        ret, frame = read_frame(cap)
        if not ret:
            break
        
        display = frame.copy()
        
        if roi:
            x1, y1, x2, y2 = roi
            roi_frame = frame[y1:y2, x1:x2]
            gray = cv2.cvtColor(roi_frame, cv2.COLOR_BGR2GRAY)
            
            m = analyze_pattern(gray)
            status, color, _ = classify_state(m)
            
            cv2.rectangle(display, (x1, y1), (x2, y2), color, 2)
            draw_lines_v10(display, m, roi)
            draw_info_panel(display, m, status, color)
        
        cv2.imshow("Live View", display)
        
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break
    
    cap.release()
    cv2.destroyAllWindows()


def calibrate():
    global BASELINE_ANGLE
    
    print("\n" + "=" * 50)
    print("  캘리브레이션 (v10 하단 도달 검출)")
    print("=" * 50)
    print("""
  [B] = 기준 각도 설정 (빈 상태에서!)
  [1] = 용액 있음 기록
  [2] = 흡수 완료 기록
  [Q] = 종료
  
  ★ 초록선(패턴)이 ROI 바닥까지 닿으면 = 흡수 완료
""")
    
    roi = load_roi()
    if not roi:
        print("ROI 없음!")
        return
    
    cap = init_camera()
    if not cap:
        return
    
    load_baseline()
    
    x1, y1, x2, y2 = roi
    vals = {}
    reset_buffers()
    
    while True:
        ret, frame = read_frame(cap)
        if not ret:
            break
        
        roi_frame = frame[y1:y2, x1:x2]
        gray = cv2.cvtColor(roi_frame, cv2.COLOR_BGR2GRAY)
        m = analyze_pattern(gray)
        status, color, _ = classify_state(m)
        
        display = frame.copy()
        cv2.rectangle(display, (x1, y1), (x2, y2), color, 2)
        draw_lines_v10(display, m, roi)
        
        # 정보
        put_korean_text(display, status, (10, 10), FONT_LARGE, color)
        put_korean_text(display, 
                        f"바닥까지: {m['distance_to_bottom']:.0f}px | 도달: {m['reach_ratio']*100:.0f}% | 기준: {BASELINE_ANGLE:.1f}°",
                        (10, 50), FONT_MEDIUM, (255, 255, 0))
        
        draw_reach_bar(display, m['reach_ratio'], m['absorbed'], 10, 80, 150, 15)
        
        # 저장값
        y_pos = 110
        for k, v in vals.items():
            put_korean_text(display, f"[{k}] {v}", (10, y_pos), FONT_SMALL, (255, 255, 255))
            y_pos += 22
        
        cv2.imshow("Calibration", display)
        
        key = cv2.waitKey(1) & 0xFF
        
        if key == ord('b') or key == ord('B'):
            if m['pattern_count'] >= 2:
                BASELINE_ANGLE = m['angle_mean']
                save_baseline(BASELINE_ANGLE)
                reset_buffers()
                print(f"\n★ 기준 각도: {BASELINE_ANGLE:.1f}°")
            else:
                print("\n패턴 직선 부족!")
        
        elif key == ord('1'):
            vals['1'] = f"용액: 거리 {m['distance_to_bottom']:.0f}px, 도달 {m['reach_ratio']*100:.0f}%"
            print(f"[1] 용액: 거리 {m['distance_to_bottom']:.0f}px, 도달 {m['reach_ratio']*100:.0f}%")
        
        elif key == ord('2'):
            vals['2'] = f"흡수: 거리 {m['distance_to_bottom']:.0f}px, 도달 {m['reach_ratio']*100:.0f}%"
            print(f"[2] 흡수: 거리 {m['distance_to_bottom']:.0f}px, 도달 {m['reach_ratio']*100:.0f}%")
        
        elif key == ord('q') or key == ord('Q'):
            break
    
    cap.release()
    cv2.destroyAllWindows()
    
    print(f"\n{'=' * 50}")
    print(f"  기준 각도: {BASELINE_ANGLE:.1f}°")
    for k, v in vals.items():
        print(f"  [{k}] {v}")
    print(f"{'=' * 50}")


