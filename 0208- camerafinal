def wait_for_absorbed(timeout=300):
    """용액이 흡수될 때까지 대기"""
    roi = load_roi()
    if not roi:
        return False
    cap = init_camera()
    if not cap:
        return False
    
    load_baseline()
    x1, y1, x2, y2 = roi
    stable_counter = 0
    start_time = time.time()
    reset_buffers()
    print("흡수 대기 (패턴이 하단까지 도달할 때까지)...")
    
    while time.time() - start_time < timeout:
        ret, frame = read_frame(cap)
        if not ret:
            continue
        roi_frame = frame[y1:y2, x1:x2]
        gray = cv2.cvtColor(roi_frame, cv2.COLOR_BGR2GRAY)
        m = analyze_pattern(gray)
        
        if m['absorbed']:
            stable_counter += 1
        else:
            stable_counter = 0
        
        elapsed = time.time() - start_time
        status = "흡수" if m['absorbed'] else "용액"
        print(f"\r   {elapsed:.0f}초 | {status} | 거리:{m['distance_to_bottom']:.0f}px 도달:{m['reach_ratio']*100:.0f}% | {stable_counter}/{STABLE_COUNT}",
              end='', flush=True)
        
        if stable_counter >= STABLE_COUNT:
            print(f"\n완료!")
            cap.release()
            return True
        time.sleep(CHECK_INTERVAL)
    
    print(f"\n타임아웃")
    cap.release()
    return False


