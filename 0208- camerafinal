        if not ret:
            break
        
        roi_frame = frame[y1:y2, x1:x2]
        gray = cv2.cvtColor(roi_frame, cv2.COLOR_BGR2GRAY)
        m = analyze_pattern(gray)
        status, color, _ = classify_state(m)
        
        display = frame.copy()
        cv2.rectangle(display, (x1, y1), (x2, y2), color, 2)
        draw_lines_v10(display, m, roi)
        
        put_korean_text(display, f"{status} | 도달:{m['reach_ratio']*100:.0f}% 거리:{m['distance_to_bottom']:.0f}px",
                        (10, 10), FONT_LARGE, color)
        
        cv2.imshow("Monitor", display)
        
        if cv2.waitKey(int(CHECK_INTERVAL * 1000)) & 0xFF == ord('q'):
            break
    
    cap.release()
    cv2.destroyAllWindows()


def absorption_test():
    """흡수 테스트"""
    print("\n흡수 테스트 (v10)")
    print("용액 넣고 → 흡수될 때까지")
    
    roi = load_roi()
    if not roi:
        print("ROI 없음!")
        return
    
    cap = init_camera()
    if not cap:
        return
    
    load_baseline()
    x1, y1, x2, y2 = roi
    state = 'wait_liquid'
    stable_counter = 0
    reset_buffers()
    
    print("\n용액을 넣으세요...")
    
    while True:
        ret, frame = read_frame(cap)
        if not ret:
            break
        
        roi_frame = frame[y1:y2, x1:x2]
        gray = cv2.cvtColor(roi_frame, cv2.COLOR_BGR2GRAY)
        m = analyze_pattern(gray)
        
        display = frame.copy()
        draw_lines_v10(display, m, roi)
        
        if state == 'wait_liquid':
            # 용액 들어옴 = 패턴이 하단에 안 닿음
            if not m['absorbed']:
                stable_counter += 1
            else:
                stable_counter = 0
            
            if stable_counter >= STABLE_COUNT:
                beep_alert()
                print("\n용액 감지!")
                state = 'wait_absorb'
                stable_counter = 0
            
            status = f"[대기] 거리:{m['distance_to_bottom']:.0f}px"
            color = (255, 255, 0)
            instruction = ">>> 용액을 넣으세요 <<<"
        
        else:  # wait_absorb
            # 흡수 완료 = 패턴이 하단까지 도달
            if m['absorbed']:
                stable_counter += 1
            else:
                stable_counter = 0
            
            if stable_counter >= STABLE_COUNT:
                beep_alert()
                print("\n흡수 완료!")
                break
            
            status = f"[흡수중] 거리:{m['distance_to_bottom']:.0f}px ({m['reach_ratio']*100:.0f}%)"
            color = (0, 255, 255)
            instruction = "흡수 중..."
        
        cv2.rectangle(display, (x1, y1), (x2, y2), color, 2)
        put_korean_text(display, status, (10, 10), FONT_MEDIUM, color)
        put_korean_text(display, instruction, (10, 40), FONT_LARGE, (255, 255, 255))
        put_korean_text(display, f"Stable: {stable_counter}/{STABLE_COUNT}",
                        (10, 75), FONT_SMALL, (200, 200, 200))
        draw_reach_bar(display, m['reach_ratio'], m['absorbed'], 10, 100, 150, 15)
        
        cv2.imshow("Absorption Test", display)
        
        if cv2.waitKey(int(CHECK_INTERVAL * 1000)) & 0xFF == ord('q'):
            break
    
    cap.release()
    cv2.destroyAllWindows()


