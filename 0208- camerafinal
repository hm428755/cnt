"""
패턴 굴절 감지 v10 - 패턴 하단 도달 검출

핵심 아이디어:
  - 대각선 패턴이 ROI 하단까지 닿으면 → 흡수 완료
  - 대각선이 상단에만 있고 하단에 없으면 → 용액 있음
  
원리:
  - 용액 있음: 굴절로 인해 패턴이 하단에서 안 보임
  - 용액 없음: 패턴이 ROI 전체에 걸쳐 하단까지 보임

장점:
  - 경계면(수평선) 감지 필요 없음
  - 젤이 깎여서 내려가도 상관없음
  - CNT 색상에 영향 안 받음

설치: pip install opencv-python numpy pillow
"""

import cv2
import numpy as np
import time
import json
import os
import winsound
from collections import deque
from PIL import ImageFont, ImageDraw, Image


# ============================================================
#                    [설정]
# ============================================================

CAMERA_INDEX = 1

ANTI_FLICKER = True
FRAME_AVG_COUNT = 5

# --- 가우시안 블러 ---
BLUR_KERNEL = 3

# --- ROI 마진 ---
ROI_MARGIN = 5

# --- 허프 직선 파라미터 ---
CANNY_LOW = 50
CANNY_HIGH = 150
HOUGH_THRESHOLD = 25
MIN_LINE_LENGTH = 20
MAX_LINE_GAP = 10

# --- 기준 각도 (대각선 패턴) ---
BASELINE_ANGLE = 54.2

# --- 패턴 각도 허용 범위 ---
PATTERN_ANGLE_TOLERANCE = 20.0

# --- 하단 도달 판별 (v10 핵심) ---
# 패턴이 ROI 바닥에서 이 픽셀 이내까지 내려오면 "흡수 완료"
BOTTOM_MARGIN_PX = 3             # ROI 바닥까지 거의 닿아야 (3px 여유)

# --- 이동평균 ---
MOVING_AVG_SIZE = 5

# --- 파일 ---
ROI_FILE = 'roi_settings.json'
BASELINE_FILE = 'baseline_settings.json'

# --- 타이밍 ---
CHECK_INTERVAL = 0.5
STABLE_COUNT = 8

