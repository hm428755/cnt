"""
테스트: 컨디셔닝 흡수 감지 → CNT → 일루션 (1회)

흐름:
1. 컨디셔닝 흡수 완료 감지 (이미 주입된 상태)
2. 밸브 → CNT
3. CNT 10ml 주입
4. 밸브 → 일루션
5. 일루션 50ml 주입
6. 일루션 흡수 완료 감지
7. 완료
"""

import cv2
import time

from devices.pump import Pump
from devices.valve import Valve
from config import *

from pattern_refraction_v10 import (
    load_roi,
    load_baseline,
    reset_buffers,
    init_camera,
    read_frame,
    analyze_pattern,
    draw_lines_v10,
    put_korean_text,
    classify_state,
    beep_alert,
    draw_reach_bar,
    wait_for_absorbed_with_display,
    FONT_LARGE, FONT_MEDIUM, FONT_SMALL,
    STABLE_COUNT,
)


def inject_with_display(cap, roi, pump, volume, flow_rate, phase_name):
    """펌프 주입하면서 카메라 화면 표시"""
    x1, y1, x2, y2 = roi
    injection_time_sec = volume / flow_rate * 60
    
    print(f"\n  펌프 시작: {flow_rate} ml/min ({injection_time_sec:.0f}초)")
    pump.run_continuous(flow_rate)
    
    injection_start = time.time()
    reset_buffers()
    
    while True:
        ret, frame = read_frame(cap)
        if not ret:
            continue
        
        roi_frame = frame[y1:y2, x1:x2]
        gray = cv2.cvtColor(roi_frame, cv2.COLOR_BGR2GRAY)
        m = analyze_pattern(gray)
        
        elapsed = time.time() - injection_start
        remaining = injection_time_sec - elapsed
        injected_ml = (elapsed / 60) * flow_rate
        progress = min(elapsed / injection_time_sec, 1.0)
        
        display = frame.copy()
        
        status, status_color, _ = classify_state(m)
        
        cv2.rectangle(display, (x1, y1), (x2, y2), status_color, 2)
        draw_lines_v10(display, m, roi)
        
        put_korean_text(display, phase_name, (10, 10), FONT_LARGE, (0, 255, 255))
        put_korean_text(display, f"{status} | 도달: {m['reach_ratio']*100:.0f}%", (10, 50), FONT_MEDIUM, status_color)
        put_korean_text(display, f"주입: {injected_ml:.1f}/{volume}ml ({progress*100:.0f}%)", (10, 85), FONT_MEDIUM, (255, 255, 0))
        put_korean_text(display, f"남은 시간: {remaining:.0f}초", (10, 120), FONT_SMALL, (200, 200, 200))
        
        # 진행 막대
        bar_y = 150
        cv2.rectangle(display, (10, bar_y), (210, bar_y + 20), (50, 50, 50), -1)
        fill_w = int(200 * progress)
        cv2.rectangle(display, (10, bar_y), (10 + fill_w, bar_y + 20), (0, 255, 255), -1)
        cv2.rectangle(display, (10, bar_y), (210, bar_y + 20), (200, 200, 200), 1)
        
        cv2.imshow("Test", display)
        
        key = cv2.waitKey(1) & 0xFF
        if key == ord('q'):
            pump.stop()
            return 'quit'
        
        if elapsed >= injection_time_sec:
            break
    
    pump.stop()
    beep_alert()
    print(f"OK {volume}ml 주입 완료!")
    return 'done'


def main():
    print("\n" + "=" * 55)
    print("  테스트: 컨디셔닝 흡수 → CNT → 일루션 (1회)")
    print("=" * 55)
    
    # ─────────────────────────────────────
    # 장비 연결
    # ─────────────────────────────────────
    
    roi = load_roi()
    if not roi:
        print("X ROI 없음!")
        return
    load_baseline()
    
    cap = init_camera()
    if not cap:
        print("X 카메라 실패!")
        return
    
    x1, y1, x2, y2 = roi
    print(f"OK 카메라 연결됨")
    
    # 펌프
    try:
        pump = Pump(
            port=PUMP_INJECTION["port"],
            address=PUMP_INJECTION["slave_id"],
            baudrate=BAUDRATE,
            rev_per_ml=REV_PER_ML,
        )
        pump.connect()
        print(f"OK 펌프 연결됨 ({PUMP_INJECTION['name']})")
    except Exception as e:
        print(f"X 펌프 실패: {e}")
        cap.release()
        return
    
    # 밸브
    valve = Valve(port=VALVE_PORT, baudrate=VALVE_BAUDRATE)
    valve_ok = valve.connect()
    if valve_ok:
        print("OK 밸브 연결됨")
    else:
        print("! 밸브 실패 - 수동 전환 필요")
    
    # ─────────────────────────────────────
    # 정보
    # ─────────────────────────────────────
    
    cnt_time = CNT_VOLUME / CNT_FLOW_RATE * 60
    elution_time = ELUTION_VOLUME / ELUTION_FLOW_RATE * 60
    
    print(f"\n  CNT: {CNT_VOLUME}ml @ {CNT_FLOW_RATE}ml/min = {cnt_time:.0f}초")
    print(f"  일루션: {ELUTION_VOLUME}ml @ {ELUTION_FLOW_RATE}ml/min = {elution_time:.0f}초")
    print("\n[조작] Q=종료  S=건너뛰기")
    
    reset_buffers()
    
    try:
        # ─────────────────────────────────────
        # Phase 1: 컨디셔닝 흡수 완료 감지
        # ─────────────────────────────────────
        
        print("\n" + "=" * 55)
        print("  Phase 1: 컨디셔닝 흡수 완료 대기")
        print("  ★ 패턴이 바닥까지 닿으면 완료")
        print("=" * 55)
        
        input("\n▶ 컨디셔닝 주입 완료 후 [Enter]...")
        
        result = wait_for_absorbed_with_display(cap, roi, TIMEOUT_CONDITIONING, "Phase 1: 컨디셔닝 흡수 대기")
        
        if result == 'quit':
            raise KeyboardInterrupt
        elif result == 'timeout':
            print("\n! 타임아웃!")
            choice = input("계속? (y/n): ").strip().lower()
            if choice != 'y':
                raise KeyboardInterrupt
        
        print("\nOK 컨디셔닝 흡수 완료!")
        
        # 흡수 완료 후 1분 대기
        print("\n  [대기] 60초 추가 대기...")
        time.sleep(60)
        print("  [대기] ✓ 대기 완료")
        
        # ─────────────────────────────────────
        # Phase 2: 밸브 → CNT
        # ─────────────────────────────────────
        
        print("\n" + "=" * 55)
        print("  Phase 2: 밸브 → CNT")
        print("=" * 55)
        
        if valve_ok:
            valve.to_solution()  # CNT = 2번
            print("OK 밸브 → CNT")
        else:
            input("▶ 밸브를 CNT로 전환하고 [Enter]...")
        
        time.sleep(0.5)
        
        # ─────────────────────────────────────
        # Phase 3: CNT 주입
        # ─────────────────────────────────────
        
        print("\n" + "=" * 55)
        print(f"  Phase 3: CNT {CNT_VOLUME}ml 주입")
        print("=" * 55)
        
        result = inject_with_display(cap, roi, pump, CNT_VOLUME, CNT_FLOW_RATE, "Phase 3: CNT 주입중")
        
        if result == 'quit':
            raise KeyboardInterrupt
        
        # ─────────────────────────────────────
        # Phase 4: 밸브 → 일루션
        # ─────────────────────────────────────
        
        print("\n" + "=" * 55)
        print("  Phase 4: 밸브 → 일루션")
        print("=" * 55)
        
        if valve_ok:
            valve.to_air()  # 일루션 = 1번
            print("OK 밸브 → 일루션")
        else:
            input("▶ 밸브를 일루션으로 전환하고 [Enter]...")
        
        time.sleep(0.5)
        
        # ─────────────────────────────────────
        # Phase 5: 일루션 주입
        # ─────────────────────────────────────
        
        print("\n" + "=" * 55)
        print(f"  Phase 5: 일루션 {ELUTION_VOLUME}ml 주입")
        print("=" * 55)
        
        result = inject_with_display(cap, roi, pump, ELUTION_VOLUME, ELUTION_FLOW_RATE, "Phase 5: 일루션 주입중")
        
        if result == 'quit':
            raise KeyboardInterrupt
        
        # ─────────────────────────────────────
        # Phase 6: 일루션 흡수 완료 대기
        # ─────────────────────────────────────
        
        print("\n" + "=" * 55)
        print("  Phase 6: 일루션 흡수 완료 대기")
        print("=" * 55)
        
        result = wait_for_absorbed_with_display(cap, roi, TIMEOUT_ELUTION, "Phase 6: 일루션 흡수 대기")
        
        if result == 'quit':
            raise KeyboardInterrupt
        elif result == 'timeout':
            print("\n! 타임아웃!")
        
        print("\nOK 일루션 흡수 완료!")
        
        # 흡수 완료 후 1분 대기
        print("\n  [대기] 60초 추가 대기...")
        time.sleep(60)
        print("  [대기] ✓ 대기 완료")
        
        # ─────────────────────────────────────
        # 완료
        # ─────────────────────────────────────
        
        print("\n" + "=" * 55)
        print("  ★ 테스트 완료!")
        print("  → 다음 CNT 넣을 준비 됨")
        print("=" * 55)
        
        beep_alert()
        
        # 결과 표시 (5초)
        monitor_start = time.time()
        while time.time() - monitor_start < 5:
            ret, frame = read_frame(cap)
            if not ret:
                continue
            
            roi_frame = frame[y1:y2, x1:x2]
            gray = cv2.cvtColor(roi_frame, cv2.COLOR_BGR2GRAY)
            m = analyze_pattern(gray)
            
            display = frame.copy()
            cv2.rectangle(display, (x1, y1), (x2, y2), (0, 255, 0), 2)
            draw_lines_v10(display, m, roi)
            
            remaining = 5 - (time.time() - monitor_start)
            put_korean_text(display, f"테스트 완료! ({remaining:.0f}초)", (10, 10), FONT_LARGE, (0, 255, 0))
            put_korean_text(display, "다음 CNT 넣을 준비 됨", (10, 50), FONT_MEDIUM, (255, 255, 255))
            
            cv2.imshow("Test", display)
            
            if cv2.waitKey(1) & 0xFF == ord('q'):
                break
        
    except KeyboardInterrupt:
        print("\n\n긴급 중단!")
        pump.stop()
        
    finally:
        pump.stop()
        pump.disconnect()
        if valve_ok:
            valve.disconnect()
        cap.release()
        cv2.destroyAllWindows()
        print("\n장비 연결 해제")


if __name__ == "__main__":
    main()
